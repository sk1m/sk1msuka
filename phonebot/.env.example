# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Ключ Claude API: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Пароль входа в админ-панель. ОБЯЗАТЕЛЬНО поменяй 1234 на свой длинный пароль.
ADMIN_PASSWORD=1234
# Твой Telegram ID (узнать: @userinfobot). Если указан, в админку пустит только этот аккаунт.
# Несколько ID — через запятую.
ADMIN_IDS=
# Куда писать за покупкой кода (твой ник в Telegram)
OWNER_CONTACT=@skimsuka
# Сколько AI-запросов в сутки на одного подписчика
DAILY_LIMIT=50
# Файл базы данных
DB_PATH=phonebot.db
