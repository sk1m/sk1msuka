# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram ID админов через запятую (узнать: @userinfobot). Только они видят админ-панель.
ADMIN_IDS=123456789
# Пароль входа в админ-панель
ADMIN_PASSWORD=придумай-пароль
# Название магазина
SHOP_NAME=Мой магазин
# Контакт продавца для кнопки «Связаться» (можно оставить пустым)
CONTACT=@skimsuka
# Валюта
CURRENCY=₽
# Файл базы данных (товары, заявки)
DB_PATH=shop.db
